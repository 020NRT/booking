# --- Reserve backend configuration ---
# Copy to backend/.env and fill in. Never commit the real .env.

# PostgreSQL (btree_gist extension is required; migrations enable it)
DATABASE_URL=postgresql+psycopg://reserve:reserve@localhost:5432/reserve
# Separate database used by pytest (will be wiped)
TEST_DATABASE_URL=postgresql+psycopg://reserve:reserve@localhost:5432/reserve_test

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=72

# Public URL of the frontend (used in QR codes and e-mails)
PUBLIC_BASE_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# First Super Admin, created by `python -m app.seed --superadmin`
SUPERADMIN_EMAIL=admin@reserve.kz
SUPERADMIN_PASSWORD=change-me-please1

# Defaults for new restaurants
DEFAULT_DEPOSIT_KZT=5000
PAYMENT_HOLD_MINUTES=10
PLATFORM_COMMISSION_PERCENT=10

# Payments. Stage 1 ships only the "mock" provider (no real money).
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-too

# Uploaded images
MEDIA_DIR=./media
MAX_UPLOAD_MB=8

# E-mail (optional). Without SMTP_HOST, e-mails are written to the log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Reserve <no-reply@reserve.kz>

# Run periodic tasks (hold expiry, auto-complete) inside the API process
RUN_SCHEDULER=true
LOG_LEVEL=INFO
